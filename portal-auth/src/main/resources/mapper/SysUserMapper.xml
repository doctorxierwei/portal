<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.portal.auth.mapper.SysUserMapper">

    <!-- 按用户名查询 (演示 XML 扩展) -->
    <select id="selectByUsername" resultType="com.portal.auth.entity.SysUser">
        SELECT *
        FROM sys_user
        WHERE username = #{username}
        LIMIT 1
    </select>

    <!-- 按 用户名 / 邮箱 / 手机号 任一登录 -->
    <select id="selectByAccount" resultType="com.portal.auth.entity.SysUser">
        SELECT *
        FROM sys_user
        WHERE username = #{account}
           OR email = #{account}
           OR phone = #{account}
        LIMIT 1
    </select>

    <!-- 按邮箱查询 -->
    <select id="selectByEmail" resultType="com.portal.auth.entity.SysUser">
        SELECT * FROM sys_user WHERE email = #{email} LIMIT 1
    </select>

    <!-- 按手机号查询 -->
    <select id="selectByPhone" resultType="com.portal.auth.entity.SysUser">
        SELECT * FROM sys_user WHERE phone = #{phone} LIMIT 1
    </select>

    <!-- 按用户ID查询角色编码 -->
    <select id="selectRoleCodesByUserId" resultType="java.lang.String">
        SELECT r.code
        FROM sys_role r
        JOIN sys_user_role ur ON ur.role_id = r.id
        WHERE ur.user_id = #{userId}
    </select>

    <!-- 查询角色编码对应的角色 id -->
    <select id="selectRoleIdByCode" resultType="java.lang.Long">
        SELECT id FROM sys_role WHERE code = #{code} LIMIT 1
    </select>

    <!-- 插入用户-角色关联 -->
    <insert id="insertUserRole">
        INSERT INTO sys_user_role (user_id, role_id) VALUES (#{userId}, #{roleId})
    </insert>

</mapper>
