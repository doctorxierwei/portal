<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.portal.user.mapper.SysMenuMapper">

    <!-- 演示: 按类型查询菜单, 复杂 SQL 写在这里 -->
    <select id="selectByType" resultType="com.portal.user.entity.SysMenu">
        SELECT *
        FROM sys_menu
        WHERE type = #{type}
        ORDER BY sort ASC
    </select>

</mapper>
